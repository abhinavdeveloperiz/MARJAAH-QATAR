# ─────────────────────────────────────────────────
# M.SHOP Qatar — Environment Variables Template
# Copy this to .env and fill in the values
# NEVER commit .env to git!
# ─────────────────────────────────────────────────

# Local development: set to True
DEBUG=True

# Generate a new secret key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key

# Your domain (e.g. marjaah.qa or marjaah-qatar.onrender.com)
ALLOWED_HOST=localhost

# Full URL including protocol (for CSRF)
SITE_URL=http://localhost:8000

# Leave blank to use SQLite locally
# On Render, this is auto-set if you create a PostgreSQL service
DATABASE_URL=

# Email (leave blank to print to console in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=M.SHOP Qatar <noreply@marjaah.qa>
CONTACT_NOTIFICATION_EMAIL=

# Set to True only when behind HTTPS (Render has HTTPS by default)
HTTPS_ENABLED=False

# Django superuser for automated creation on Render (optional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@marjaah.qa
DJANGO_SUPERUSER_PASSWORD=
