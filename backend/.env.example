# NestJS Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret for Auth & Sessions
JWT_SECRET=your-secure-jwt-secret-key-here-minimum-32-chars

# CORS Origin (comma-separated or * for dev)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Firebase Project & Storage Configuration
FIREBASE_PROJECT_ID=marjaah-ab2a6
FIREBASE_STORAGE_BUCKET=marjaah-ab2a6.firebasestorage.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@marjaah-ab2a6.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Or provide the full JSON string in FIREBASE_SERVICE_ACCOUNT_KEY
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
