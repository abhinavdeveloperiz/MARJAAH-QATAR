# NestJS Server Configuration
PORT=3001
NODE_ENV=development

# Firebase Project Configuration
FIREBASE_PROJECT_ID=marjaah-ab2a6

# Path to service account credential file (for local development)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# JWT Secret for Auth & Sessions
JWT_SECRET=your-secure-jwt-secret-key-here-minimum-32-chars

# CORS Origin (comma-separated or * for dev)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000
