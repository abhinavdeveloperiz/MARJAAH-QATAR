{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "frontend",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/robot.txt", "destination": "/robots.txt", "type": 301 },
      { "source": "/shop.html", "destination": "/shop/", "type": 301 },
      { "source": "/cart.html", "destination": "/cart/", "type": 301 },
      { "source": "/checkout.html", "destination": "/checkout/", "type": 301 },
      { "source": "/checkout-success.html", "destination": "/checkout/success/", "type": 301 },
      { "source": "/checkout-success", "destination": "/checkout/success/", "type": 301 },
      { "source": "/about.html", "destination": "/about/", "type": 301 },
      { "source": "/contact.html", "destination": "/contact/", "type": 301 },
      { "source": "/account.html", "destination": "/account/", "type": 301 },
      { "source": "/admin-dashboard.html", "destination": "/admin/", "type": 301 },
      { "source": "/admin-login", "destination": "/admin/", "type": 301 },
      { "source": "/admin-login.html", "destination": "/admin/", "type": 301 },
      { "source": "/admin/login", "destination": "/admin/", "type": 301 },
      { "source": "/admin/login/**", "destination": "/admin/", "type": 301 },
      { "source": "/login.html", "destination": "/login/", "type": 301 },
      { "source": "/register.html", "destination": "/register/", "type": 301 },
      { "source": "/forgot-password.html", "destination": "/forgot-password/", "type": 301 },
      { "source": "/offers.html", "destination": "/offers/", "type": 301 },
      { "source": "/wishlist.html", "destination": "/wishlist/", "type": 301 },
      { "source": "/product.html", "destination": "/product/", "type": 301 },
      { "source": "/privacy.html", "destination": "/privacy/", "type": 301 },
      { "source": "/privacy-policy", "destination": "/privacy/", "type": 301 },
      { "source": "/privacy-policy.html", "destination": "/privacy/", "type": 301 },
      { "source": "/returns.html", "destination": "/returns/", "type": 301 },
      { "source": "/returns-policy", "destination": "/returns/", "type": 301 },
      { "source": "/returns-policy.html", "destination": "/returns/", "type": 301 },
      { "source": "/refund-policy", "destination": "/returns/", "type": 301 },
      { "source": "/refund-policy.html", "destination": "/returns/", "type": 301 },
      { "source": "/terms.html", "destination": "/terms/", "type": 301 },
      { "source": "/terms-and-conditions", "destination": "/terms/", "type": 301 },
      { "source": "/terms-and-conditions.html", "destination": "/terms/", "type": 301 },
      { "source": "/track-order.html", "destination": "/track-order/", "type": 301 },
      { "source": "/order-tracking", "destination": "/track-order/", "type": 301 },
      { "source": "/static/images/categories/:file*", "destination": "/assets/images/categories/:file*", "type": 301 },
      { "source": "/static/images/products/:file*", "destination": "/assets/images/products/:file*", "type": 301 },
      { "source": "/static/images/banners/:file*", "destination": "/assets/images/banners/:file*", "type": 301 },
      { "source": "/static/images/branding/:file*", "destination": "/assets/images/branding/:file*", "type": 301 },
      { "source": "/static/css/:file*", "destination": "/assets/css/:file*", "type": 301 },
      { "source": "/static/js/:file*", "destination": "/assets/js/:file*", "type": 301 },
      { "source": "/images/categories/:file*", "destination": "/assets/images/categories/:file*", "type": 301 },
      { "source": "/images/products/:file*", "destination": "/assets/images/products/:file*", "type": 301 },
      { "source": "/images/banners/:file*", "destination": "/assets/images/banners/:file*", "type": 301 },
      { "source": "/css/:file*", "destination": "/assets/css/:file*", "type": 301 },
      { "source": "/js/:file*", "destination": "/assets/js/:file*", "type": 301 },
      { "source": "/en", "destination": "/", "type": 301 },
      { "source": "/en/", "destination": "/", "type": 301 },
      { "source": "/en/:path*", "destination": "/:path*", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      { "source": "/ar", "destination": "/index.html" },
      { "source": "/ar/", "destination": "/index.html" },
      { "source": "/ar/shop", "destination": "/shop/index.html" },
      { "source": "/ar/shop/**", "destination": "/shop/index.html" },
      { "source": "/ar/cart", "destination": "/cart/index.html" },
      { "source": "/ar/cart/**", "destination": "/cart/index.html" },
      { "source": "/ar/checkout", "destination": "/checkout/index.html" },
      { "source": "/ar/checkout/**", "destination": "/checkout/index.html" },
      { "source": "/ar/checkout-success", "destination": "/checkout-success/index.html" },
      { "source": "/ar/checkout-success/**", "destination": "/checkout-success/index.html" },
      { "source": "/ar/checkout/success", "destination": "/checkout-success/index.html" },
      { "source": "/ar/checkout/success/**", "destination": "/checkout-success/index.html" },
      { "source": "/ar/about", "destination": "/about/index.html" },
      { "source": "/ar/about/**", "destination": "/about/index.html" },
      { "source": "/ar/contact", "destination": "/contact/index.html" },
      { "source": "/ar/contact/**", "destination": "/contact/index.html" },
      { "source": "/ar/login", "destination": "/login/index.html" },
      { "source": "/ar/login/**", "destination": "/login/index.html" },
      { "source": "/ar/register", "destination": "/register/index.html" },
      { "source": "/ar/register/**", "destination": "/register/index.html" },
      { "source": "/ar/forgot-password", "destination": "/forgot-password/index.html" },
      { "source": "/ar/forgot-password/**", "destination": "/forgot-password/index.html" },
      { "source": "/ar/account", "destination": "/account/index.html" },
      { "source": "/ar/account/**", "destination": "/account/index.html" },
      { "source": "/ar/wishlist", "destination": "/wishlist/index.html" },
      { "source": "/ar/wishlist/**", "destination": "/wishlist/index.html" },
      { "source": "/ar/offers", "destination": "/offers/index.html" },
      { "source": "/ar/offers/**", "destination": "/offers/index.html" },
      { "source": "/product", "destination": "/product/index.html" },
      { "source": "/product/**", "destination": "/product/index.html" },
      { "source": "/ar/product", "destination": "/product/index.html" },
      { "source": "/ar/product/**", "destination": "/product/index.html" },
      { "source": "/ar/admin", "destination": "/admin/index.html" },
      { "source": "/ar/admin/**", "destination": "/admin/index.html" },
      { "source": "/ar/privacy", "destination": "/privacy/index.html" },
      { "source": "/ar/privacy/**", "destination": "/privacy/index.html" },
      { "source": "/ar/returns", "destination": "/returns/index.html" },
      { "source": "/ar/returns/**", "destination": "/returns/index.html" },
      { "source": "/ar/terms", "destination": "/terms/index.html" },
      { "source": "/ar/terms/**", "destination": "/terms/index.html" },
      { "source": "/ar/track-order", "destination": "/track-order/index.html" },
      { "source": "/ar/track-order/**", "destination": "/track-order/index.html" }
    ]
  }
}
