{
  "hosting": {
    "public": "frontend",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/shop.html", "destination": "/shop/", "type": 301 },
      { "source": "/cart.html", "destination": "/cart/", "type": 301 },
      { "source": "/checkout.html", "destination": "/checkout/", "type": 301 },
      { "source": "/checkout-success.html", "destination": "/checkout/success/", "type": 301 },
      { "source": "/checkout-success", "destination": "/checkout/success/", "type": 301 },
      { "source": "/about.html", "destination": "/about/", "type": 301 },
      { "source": "/contact.html", "destination": "/contact/", "type": 301 },
      { "source": "/account.html", "destination": "/account/", "type": 301 },
      { "source": "/admin-dashboard.html", "destination": "/admin/", "type": 301 },
      { "source": "/login.html", "destination": "/login/", "type": 301 },
      { "source": "/register.html", "destination": "/register/", "type": 301 },
      { "source": "/forgot-password.html", "destination": "/forgot-password/", "type": 301 },
      { "source": "/offers.html", "destination": "/offers/", "type": 301 },
      { "source": "/wishlist.html", "destination": "/wishlist/", "type": 301 },
      { "source": "/product.html", "destination": "/product/", "type": 301 },
      { "source": "/static/images/categories/:file*", "destination": "/assets/images/categories/:file*", "type": 301 },
      { "source": "/static/images/products/:file*", "destination": "/assets/images/products/:file*", "type": 301 },
      { "source": "/static/images/banners/:file*", "destination": "/assets/images/banners/:file*", "type": 301 },
      { "source": "/static/images/branding/:file*", "destination": "/assets/images/branding/:file*", "type": 301 },
      { "source": "/static/css/:file*", "destination": "/assets/css/:file*", "type": 301 },
      { "source": "/static/js/:file*", "destination": "/assets/js/:file*", "type": 301 },
      { "source": "/images/categories/:file*", "destination": "/assets/images/categories/:file*", "type": 301 },
      { "source": "/images/products/:file*", "destination": "/assets/images/products/:file*", "type": 301 },
      { "source": "/images/banners/:file*", "destination": "/assets/images/banners/:file*", "type": 301 },
      { "source": "/css/:file*", "destination": "/assets/css/:file*", "type": 301 },
      { "source": "/js/:file*", "destination": "/assets/js/:file*", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "marjaah-backend",
          "region": "us-central1"
        }
      }
    ]
  }
}
